# Optional local LLM configuration
OLLAMA_URL=
OLLAMA_MODEL=

# Application output
CRAWLER_OUTPUT_DIR=output

# Conservative crawl defaults
CRAWLER_DEFAULT_MAX_PAGES=10
CRAWLER_NAVIGATION_TIMEOUT_MS=60000
CRAWLER_PAGE_TIMEOUT_MS=30000

# LLM Gateway (LiteLLM)
LLM_GATEWAY_ENABLED=true
LLM_GATEWAY_URL=http://litellm:4000/v1
LLM_GATEWAY_MODEL=portfolio-free
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional local Ollama fallback
USE_OLLAMA_FALLBACK=false
OLLAMA_URL=
OLLAMA_MODEL=

# LiteLLM upstream model IDs
OPENROUTER_LITELLM_MODEL=openrouter/free
GEMINI_LITELLM_MODEL=gemini/gemini-flash-lite-latest
